# API base URL the SPA calls. In production this is the backend's public URL.
VITE_API_URL=https://api.your-domain.example

# Canonical public site URL (used for SEO / OpenGraph / canonical tags).
# Should match the deployed frontend origin.
VITE_SITE_URL=https://www.your-domain.example

# RevenueCat web SDK publishable key. Required for billing / entitlements.
VITE_REVENUECAT_WEB_API_KEY=

# --- DANGER ZONE -------------------------------------------------------------
# VITE_ZENIN_DEV_FULL_ACCESS: development-only backdoor that grants full account
# access without authentication. NEVER set this in production. The tracked
# frontend/.env.development enables it for local convenience; it must not be
# copied to staging or production environments.
# VITE_ZENIN_DEV_FULL_ACCESS=false

# -----------------------------------------------------------------------------
# Sentry — Error monitoring, performance, Session Replay, and release tracking.
# -----------------------------------------------------------------------------
# The frontend initializes Sentry ONLY when VITE_SENTRY_FRONTEND_DSN is set.
# Without a DSN the module is a safe no-op, so local dev is unaffected.
#
# Use a separate Sentry project from the backend (e.g. zenin-frontend). The
# auth token is used only at build time by @sentry/vite-plugin to upload
# sourcemaps; it is NOT bundled into the client.
VITE_SENTRY_FRONTEND_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_ORG=
VITE_SENTRY_FRONTEND_PROJECT=
VITE_SENTRY_AUTH_TOKEN=
# Performance sampling (0.0–1.0). 0 disables tracing.
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
# Session Replay: fraction of normal sessions recorded for UX review.
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.1
# Session Replay: fraction of sessions recorded when an error occurs (1.0 = all).
VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0
