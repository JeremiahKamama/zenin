{
  "name": "portfolio-manager-backend",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "build": "bash setup_venv.sh",
    "telegram:session": "node scripts/telegram-session.js",
    "migrate:admin-workspace": "node scripts/run-admin-workspace-migration.js",
    "security:workspace-smoke": "node scripts/security-workspace-smoke.js",
    "test:integration": "node --test test/integration/*.test.js",
    "test:unit": "node --test $(find test/unit -name '*.test.js' | tr '\\n' ' ')",
    "test": "node --test $(find test/unit -name '*.test.js' | tr '\\n' ' ')"
  },
  "dependencies": {
    "@simplewebauthn/server": "^9.0.3",
    "apple-signin-auth": "^1.7.5",
    "axios": "^1.16.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "express-rate-limit": "^7.4.1",
    "google-auth-library": "^10.7.0",
    "helmet": "^8.0.0",
    "node-fetch": "^3.3.2",
    "nodemailer": "^9.0.1",
    "otplib": "^13.4.0",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "qs": "^6.15.2",
    "resend": "^6.12.4",
    "snaptrade-typescript-sdk": "^10.0.17",
    "svix": "^1.95.1",
    "telegram": "^2.26.22",
    "ws": "^8.21.0",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
