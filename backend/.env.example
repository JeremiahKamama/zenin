PORT=4000
PUBLIC_APP_ORIGIN=https://www.zenin.capital
FRONTEND_URL=https://www.zenin.capital
# Optional: comma-separated list of allowed frontend origins.
# Example: FRONTEND_URLS=https://zenin.capital,https://www.zenin.capital
# Local development can override these values in an uncommitted .env file.
FRONTEND_URLS=
DATABASE_URL=postgres://username:password@host:5432/database
# Optional SSL controls (set for managed/self-signed PostgreSQL endpoints).
# Production defaults to certificate verification; only disable for local throwaway databases.
PGSSLMODE=require
PGSSL_REJECT_UNAUTHORIZED=true
EODHD_API_TOKEN=replace_with_your_eodhd_token
FRED_API_KEY=replace_with_your_fred_api_key
BLS_API_KEY=replace_with_your_bls_api_key
MASSIVE_API_KEY=replace_with_your_massive_api_key
# Massive also accepts legacy/rebranded Polygon key env names.
# POLY_API_KEY=replace_with_your_massive_api_key
# POLYGON_API_KEY=replace_with_your_massive_api_key
MASSIVE_REST_BASE_URL=https://api.massive.com
# Optional Massive WebSocket overrides. Defaults target stock and equity-options streams.
MASSIVE_WS_STOCKS_URL=wss://socket.massive.com/stocks
MASSIVE_WS_DELAYED_STOCKS_URL=wss://delayed.massive.com/stocks
MASSIVE_WS_OPTIONS_URL=wss://socket.massive.com/options
MASSIVE_WS_DELAYED_OPTIONS_URL=wss://delayed.massive.com/options
# Set true if your Massive plan is delayed rather than real-time.
MASSIVE_WS_DELAYED=false
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_telegram_api_hash
TELEGRAM_SESSION_STRING=your_saved_telegram_string_session
TELEGRAM_CHANNEL_USERNAME=derivetradetape
TELEGRAM_FETCH_LIMIT=160
TELEGRAM_CACHE_TTL_MS=60000
# Optional public-data headers/keys for company-profile enrichment
SEC_USER_AGENT=Zenin Company Profile your-email@example.com
EIA_API_KEY=replace_with_your_eia_api_key
DUNE_API_KEY=replace_with_your_dune_api_key
RESEND_API_KEY=re_replace_with_your_resend_api_key
RESEND_WEBHOOK_SECRET=whsec_replace_with_your_resend_webhook_signing_secret
RESEND_EMAIL_VERIFICATION_TEMPLATE_ID=email-verification
RESEND_EMAIL_CHANGE_TEMPLATE_ID=email-change-verification
RESEND_PASSWORD_RESET_TEMPLATE_ID=reset-password
RESEND_ALERT_TEMPLATE_ID=
# Brokerage Configuration
BROKERAGE_PROVIDER=snaptrade
SNAPTRADE_CLIENT_ID=your_snaptrade_client_id
SNAPTRADE_CONSUMER_KEY=your_snaptrade_consumer_key
SNAPTRADE_SECRET=your_snaptrade_secret
SNAPTRADE_CALLBACK_URL=https://www.zenin.capital/brokerage/snaptrade/callback
SNAPTRADE_ENVIRONMENT=production

# Market Intelligence Configuration
MARKET_DATA_PROVIDER=fmp
FMP_API_KEY=replace_with_your_fmp_api_key
# Alternative env var names (checked in order): FMP_API_KEY, FINANCIAL_MODELING_PREP_API_KEY, FINANCIAL_MODELING_PREP_APIKEY
MARKET_INTEL_BACKGROUND_SYNC=true
FMP_BASE_URL=https://financialmodelingprep.com/api/v3
FMP_V4_BASE_URL=https://financialmodelingprep.com/api/v4

# Company Profile Aggregation Service
# Set to true to use the new Node.js aggregation service instead of the Python pipeline.
ENABLE_NEW_COMPANY_PROFILE=false
# Redis cache layer (optional; falls back to memory + Postgres if absent)
# REDIS_URL=redis://localhost:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
FMP_RATE_LIMIT_CAPACITY=300
FMP_RATE_LIMIT_REFILL=10
FMP_BREAKER_FAILURE_THRESHOLD=5
FMP_BREAKER_COOLDOWN_MS=30000
FMP_RETRY_ATTEMPTS=3
FMP_RETRY_BASE_DELAY_MS=100
FMP_RETRY_MAX_DELAY_MS=1000
LEGACY_BREAKER_FAILURE_THRESHOLD=5
LEGACY_BREAKER_COOLDOWN_MS=30000


# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
ZENIN_APP_SECRET=replace_with_a_strong_dashboard_password
AUTH_HASH_KEY=replace_with_a_strong_random_auth_hash_key
ENABLE_DEV_AUTH_DEBUG=false
ENABLE_OAUTH_MOCK=false
# Optional: comma-separated IPv4/IPv6 addresses allowed to reach admin routes in production.
# Example: ADMIN_ALLOWED_IPS=203.0.113.10,2001:db8::10
ADMIN_ALLOWED_IPS=
ADMIN_EMAIL=admin@zenin.app
ADMIN_MIGRATION_KEY=replace_with_one_time_admin_migration_key

# Email / SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=password
SMTP_FROM="Zenin Capital <noreply@zenin.capital>"

# OAuth Configuration
# REDIRECT_URI_BASE is optional, defaults to the request host. 
# Set it if the backend is behind a proxy or has a different public URL.
# REDIRECT_URI_BASE=https://api.zenin.capital
# PUBLIC_APP_ORIGIN above is used for OAuth redirects and auth handoff.
# Google Cloud Console must include the exact callback URI under
# "Authorized redirect URIs". By default Zenin uses the frontend callback:
#   https://www.zenin.capital/auth/oauth/google/callback
# Set GOOGLE_REDIRECT_URI only if you intentionally want a backend callback fallback:
#   https://zenin-mx6w.onrender.com/api/auth/oauth/google/callback

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

APPLE_CLIENT_ID=your_apple_service_id
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# -----------------------------------------------------------------------------
# Additional configuration (documented for completeness)
# -----------------------------------------------------------------------------
# These variables are read by the backend but not listed above. Aliases are
# resolved in code in the order shown.

# Optional WebAuthn Relying Party id / expected origin. Defaults derive from
# PUBLIC_APP_ORIGIN / FRONTEND_URL.
# RP_ID=www.zenin.capital
# EXPECTED_ORIGIN=https://www.zenin.capital

# Aliases for EODHD (code checks EODHD_API_KEY, then EODHD_TOKEN, then EODHD_API_TOKEN).
# EODHD_API_KEY=replace_with_your_eodhd_token
# EODHD_TOKEN=replace_with_your_eodhd_token

# Alias for MASSIVE_API_KEY (code falls back to MASSIVE_TOKEN).
# MASSIVE_TOKEN=replace_with_your_massive_api_key

# Alias for RESEND_WEBHOOK_SECRET (code also checks RESEND_WEBHOOK_SIGNING_SECRET).
# RESEND_WEBHOOK_SIGNING_SECRET=whsec_replace_with_your_resend_webhook_signing_secret

# Optional generic webhook secret used by the admin status dashboard.
# WEBHOOK_SECRET=replace_with_your_webhook_secret

# Billing / entitlements. Required if RevenueCat entitlements are enforced.
REVENUECAT_API_KEY=replace_with_your_revenuecat_api_key
REVENUECAT_SECRET_KEY=replace_with_your_revenuecat_secret_key
REVENUECAT_PROJECT_ID=replace_with_your_revenuecat_project_id
# RevenueCat V2 webhook signing secret (optional, used by the v2 webhook handler).
# REVENUECAT_V2_SECRET_KEY=replace_with_your_revenuecat_v2_secret_key

# Stripe (read-only billing dashboard). Required only if the Stripe status panel is enabled.
# STRIPE_SECRET_KEY=replace_with_your_stripe_secret_key

# Optional read-replica for heavy read queries. Falls back to DATABASE_URL.
# DATABASE_READ_REPLICA_URL=postgres://user:pass@host:5432/db

# Brokerage background-sync controls.
# BROKERAGE_BACKGROUND_SYNC=true            # set to "false" to disable
# BROKERAGE_SYNC_INTERVAL_MS=900000          # 15 minutes
# BROKERAGE_SYNC_STALE_MS=3600000            # 1 hour

# WebSocket price-push throttle (ms between client pushes).
# WS_PRICE_PUSH_INTERVAL_MS=1000

# Telegram channel allow-list (comma-separated usernames).
# TELEGRAM_CHANNEL_USERNAMES=derivetradetape

# Derive / perps calculator API base.
# DERIVE_API_URL=https://api.derive.xyz

# Perps bench runner mode / rate.
# PERPS_BENCH_MODE=
# PERPS_BENCH_RATE_MS=

# BLS registration key (Bureau of Labor Statistics series registration).
# BLS_REGISTRATION_KEY=replace_with_your_bls_registration_key

# Python binary override for the company-profile python pipeline.
# PYTHON_BINARY=python3

# Allow Vercel preview origins (NON-PRODUCTION ONLY). When true, any
# *.vercel.app origin in FRONTEND_URLS is accepted. Never enable in production.
ALLOW_VERCEL_PREVIEW_ORIGINS=false

# --- DANGER ZONE -------------------------------------------------------------
# ZENIN_ADMIN_BYPASS: development-only admin backdoor. When set to "true",
#   the dev admin bypass is enabled. The server REFUSES to start in production
#   (NODE_ENV=production) if this is set. Leave unset / false everywhere except
#   local dev.
ZENIN_ADMIN_BYPASS=false

# -----------------------------------------------------------------------------
# Sentry — Error monitoring, performance, and release tracking.
# -----------------------------------------------------------------------------
# The backend initializes Sentry ONLY when SENTRY_BACKEND_DSN is set. With no
# DSN the Sentry module is a safe no-op, so local development is unaffected.
#
# Create one Sentry project per app (zenin-backend, zenin-frontend) and put the
# respective DSNs here. The shared org/project slugs are used by sentry-cli for
# sourcemap upload; the auth token is a per-env auth token from Sentry Settings
# → Auth Tokens (scope: project:releases + project:write).
SENTRY_BACKEND_DSN=
# Shared across apps. Defaults to "production"; set to "staging"/"development" per deploy.
SENTRY_ENVIRONMENT=production
# Optional. If unset, the backend derives a release from the current git SHA.
SENTRY_RELEASE=
SENTRY_ORG=
SENTRY_BACKEND_PROJECT=
# Used only during builds for sourcemap upload. Never required to run the server.
SENTRY_BACKEND_AUTH_TOKEN=
# Performance sampling (0.0–1.0). 0 disables tracing.
SENTRY_TRACES_SAMPLE_RATE=0.1
# Profiling samples (0.0–1.0). Profiling requires tracing to be enabled.
SENTRY_PROFILES_SAMPLE_RATE=0.1
