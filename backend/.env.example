PORT=4000
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgres://username:password@host:5432/database
# Optional SSL controls (set for managed/self-signed PostgreSQL endpoints)
# Render deployments auto-default to non-strict verify unless PGSSL_REJECT_UNAUTHORIZED is explicitly set.
PGSSLMODE=require
PGSSL_REJECT_UNAUTHORIZED=false
EODHD_API_TOKEN=replace_with_your_eodhd_token
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_telegram_api_hash
TELEGRAM_SESSION_STRING=your_saved_telegram_string_session
TELEGRAM_CHANNEL_USERNAME=derivetradetape
TELEGRAM_FETCH_LIMIT=160
TELEGRAM_CACHE_TTL_MS=60000
