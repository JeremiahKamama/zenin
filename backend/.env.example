PORT=4000
FRONTEND_URL=http://localhost:5173
# Optional: comma-separated list of allowed frontend origins.
# Example: FRONTEND_URLS=https://zenin.capital,https://www.zenin.capital,http://localhost:5173
FRONTEND_URLS=
DATABASE_URL=postgres://username:password@host:5432/database
# Supabase runtime database/auth configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_DB_URL=
SUPABASE_DATABASE_URL=
SUPABASE_DIRECT_URL=
# Optional SSL controls (set for managed/self-signed PostgreSQL endpoints).
# Production defaults to certificate verification; only disable for local throwaway databases.
PGSSLMODE=require
PGSSL_REJECT_UNAUTHORIZED=true
EODHD_API_TOKEN=replace_with_your_eodhd_token
FRED_API_KEY=replace_with_your_fred_api_key
BLS_API_KEY=replace_with_your_bls_api_key
MASSIVE_API_KEY=replace_with_your_massive_api_key
# Optional Massive WebSocket overrides. Defaults target stock aggregate streams.
MASSIVE_WS_STOCKS_URL=wss://socket.massive.com/stocks
MASSIVE_WS_DELAYED_STOCKS_URL=wss://delayed.massive.com/stocks
# Set true if your Massive plan is delayed rather than real-time.
MASSIVE_WS_DELAYED=false
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_telegram_api_hash
TELEGRAM_SESSION_STRING=your_saved_telegram_string_session
TELEGRAM_CHANNEL_USERNAME=derivetradetape
TELEGRAM_FETCH_LIMIT=160
TELEGRAM_CACHE_TTL_MS=60000
# Optional public-data headers/keys for company-profile enrichment
SEC_USER_AGENT=Zenin Company Profile your-email@example.com
EIA_API_KEY=replace_with_your_eia_api_key
DUNE_API_KEY=replace_with_your_dune_api_key
RESEND_API_KEY=re_replace_with_your_resend_api_key


# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
ZENIN_APP_SECRET=replace_with_a_strong_dashboard_password
AUTH_HASH_KEY=replace_with_a_strong_random_auth_hash_key
ENABLE_DEV_AUTH_DEBUG=false
ENABLE_OAUTH_MOCK=false
# Optional: comma-separated IPv4/IPv6 addresses allowed to reach admin routes in production.
# Example: ADMIN_ALLOWED_IPS=203.0.113.10,2001:db8::10
ADMIN_ALLOWED_IPS=
ADMIN_EMAIL=admin@zenin.app
ADMIN_MIGRATION_KEY=replace_with_one_time_admin_migration_key

# Email / SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=password
SMTP_FROM="Zenin Capital <noreply@zenin.capital>"

# OAuth Configuration
# REDIRECT_URI_BASE is optional, defaults to the request host. 
# Set it if the backend is behind a proxy or has a different public URL.
# REDIRECT_URI_BASE=https://api.zenin.capital

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

APPLE_CLIENT_ID=your_apple_service_id
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
