   * @type {string}
   * @memberof UniversalSymbol
   */
  'symbol': string;
  /**
   * The raw symbol is `symbol` with the exchange suffix removed. For example, if `symbol` is \"VAB.TO\", then `raw_symbol` is \"VAB\".
   * @type {string}
   * @memberof UniversalSymbol
